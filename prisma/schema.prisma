generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────── Better Auth tables (shared user directory) ─────────
model User {
  id               String   @id
  name             String
  email            String   @unique
  emailVerified    Boolean  @default(false)
  image            String?
  twoFactorEnabled Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sessions          Session[]
  accounts          Account[]
  twoFactors        TwoFactor[]
  staffMemberships  StaffMembership[]
  clientMemberships ClientMembership[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id          String @id
  secret      String
  backupCodes String
  userId      String
  verified    Boolean   @default(true)
  failedVerificationCount Int @default(0)
  lockedUntil DateTime?
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor")
}

// ───────── Workspace, access ─────────
model Workspace {
  vaultEntries VaultEntry[]
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  timezone  String   @default("Europe/London")
  // Our own company details, shown on every agreement. Never invented: empty until the team fills them in.
  legalName         String?
  companyNumber     String?
  registeredAddress String?
  vatNumber         String?
  settings          Json     @default("{}") // values the legal documents quote: support hours, notice period, emails...
  createdAt DateTime @default(now())

  plans     ServicePlan[]
  staff     StaffMembership[]
  customers Customer[]
}

enum StaffRole {
  owner
  member
  client_director
  delivery
  sales
  support
  finance
}

enum MembershipStatus {
  pending
  active
  deactivated
}

model StaffMembership {
  id          String           @id @default(uuid()) @db.Uuid
  workspaceId String           @db.Uuid
  userId      String?
  email       String
  displayName String
  username    String?
  aliasEmail  String? // customer-facing address, e.g. abukar@onesimplesite.co.uk
  jobTitle    String?
  phone       String?
  signature   String?
  role        StaffRole
  status      MembershipStatus @default(pending)
  createdAt   DateTime         @default(now())
  deactivatedAt DateTime?
  photo       Bytes?
  photoType   String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@unique([workspaceId, username])
  @@unique([workspaceId, aliasEmail])
  @@index([userId])
}

// Single-use invitations; only the SHA-256 of the token is stored.
model Invitation {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  kind        String // staff | client
  email       String
  tokenHash   String    @unique
  staffRole   StaffRole?
  customerId  String?   @db.Uuid
  clientRole  ClientRole?
  clientBilling Boolean   @default(false)
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, email])
}

enum ClientRole {
  admin // Owner: everything, including who has access
  member // Team member: projects, documents and tickets
  viewer // View only
}

model ClientMembership {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String
  customerId String     @db.Uuid
  role       ClientRole @default(member)
  billing    Boolean    @default(false)
  revokedAt  DateTime?
  createdAt  DateTime   @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@unique([userId, customerId])
  @@index([customerId])
}

// ───────── CRM ─────────
enum Lifecycle {
  prospect
  active
  paused
  former
}

model Customer {
  id            String    @id @default(uuid()) @db.Uuid
  workspaceId   String    @db.Uuid
  reference     String
  displayName   String
  legalName     String?
  kind          String    @default("business") // business (a company) | sole_trader | individual
  businessType  String? // what kind of business: Food and drink, Trades...
  stripeCustomerId String?
  town          String?
  lifecycle     Lifecycle @default(prospect)
  atRisk        Boolean   @default(false)
  ownerId       String?   @db.Uuid // StaffMembership
  source        String?
  website       String?
  phone         String?
  billingAddress String?
  companyNumber String?
  vatNumber     String?
  tags          String[]
  archivedAt    DateTime?
  version       Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  contacts      Contact[]
  tickets       Ticket[]
  opportunities Opportunity[]
  proposals     Proposal[]
  contracts     Contract[]
  projects      Project[]
  memberships   ClientMembership[]

  @@unique([workspaceId, reference])
  @@unique([id, workspaceId])
  @@index([workspaceId, lifecycle])
}

model Contact {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  customerId  String   @db.Uuid
  name        String
  email       String?
  phone       String?
  isPrimary   Boolean  @default(false)
  marketingOptIn Boolean @default(false)
  position    String? // where they sit in the business: Owner, Director, Manager...
  createdAt   DateTime @default(now())

  customer Customer @relation(fields: [customerId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  tickets  Ticket[]

  @@index([workspaceId, customerId])
  @@index([workspaceId, email])
}

enum OpportunityStage {
  new
  qualified
  proposal_sent
  contract_pending
  won
  lost
}

model Opportunity {
  id          String           @id @default(uuid()) @db.Uuid
  workspaceId String           @db.Uuid
  customerId  String           @db.Uuid
  title       String
  stage       OpportunityStage @default(new)
  valueMinor  Int              @default(0)
  currency    String           @default("GBP")
  ownerId     String?          @db.Uuid
  lossReason  String?
  priority    String           @default("normal") // low | normal | high | urgent
  dueDate     DateTime?
  version     Int              @default(1)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  customer Customer @relation(fields: [customerId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  proposals Proposal[]

  @@index([workspaceId, stage])
  @@index([workspaceId, customerId])
}

// ───────── Sales: proposals (sent versions immutable) ─────────
enum ProposalStatus {
  draft
  sent
  accepted
  declined
  expired
  withdrawn
}

model Proposal {
  id             String         @id @default(uuid()) @db.Uuid
  workspaceId    String         @db.Uuid
  customerId     String         @db.Uuid
  opportunityId  String?        @db.Uuid
  reference      String
  title          String
  status         ProposalStatus @default(draft)
  currentVersion Int            @default(1)
  acceptedVersionId String?     @db.Uuid
  version        Int            @default(1) // optimistic concurrency
  createdById    String?        @db.Uuid
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  customer Customer @relation(fields: [customerId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  opportunity Opportunity?      @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  versions    ProposalVersion[]

  @@unique([workspaceId, reference])
  @@index([workspaceId, customerId])
  @@index([workspaceId, status])
}

model ProposalVersion {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  proposalId  String    @db.Uuid
  number      Int
  scope       String // structured text: scope, deliverables, exclusions
  terms       String
  currency    String    @default("GBP")
  oneOffMinor Int       @default(0)
  recurringMinor Int    @default(0)
  recurringPeriod String? // month | year
  requirements Json? // website requirements + payment schedule, filled in by the team for each deal
  validUntil  DateTime?
  sentAt      DateTime? // non-null => immutable (enforced by trigger)
  sentToEmail String?
  supersededAt DateTime?
  createdAt   DateTime  @default(now())

  proposal    Proposal           @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  lines       ProposalLine[]
  acceptances ProposalAcceptance[]
  contract    Contract?

  @@unique([proposalId, number])
  @@index([workspaceId])
}

model ProposalLine {
  id          String   @id @default(uuid()) @db.Uuid
  versionId   String   @db.Uuid
  position    Int
  description String
  quantity    Int
  unitMinor   Int
  recurring   Boolean  @default(false)

  version ProposalVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@unique([versionId, position])
}

// Acceptance binds exactly one version; one acceptance per version.
model ProposalAcceptance {
  id            String   @id @default(uuid()) @db.Uuid
  workspaceId   String   @db.Uuid
  versionId     String   @unique @db.Uuid
  acceptedName  String
  acceptedEmail String
  termsText     String // exact acceptance wording shown
  termsVersion  String
  ipAddress     String? // from trusted proxy header only
  userAgent     String?
  acceptedAt    DateTime @default(now()) // server time

  version ProposalVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
}

// High-entropy link tokens, stored hashed, scoped to one purpose + entity.
model ScopedLinkToken {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  purpose     String // proposal_accept | contract_sign
  entityId    String    @db.Uuid
  tokenHash   String    @unique
  recipientEmail String
  expiresAt   DateTime
  revokedAt   DateTime?
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, purpose, entityId])
}

// ───────── Contracts (signing evidence lives with the signing module) ─────────
enum ContractStatus {
  draft
  awaiting_signature
  completed
  declined
  expired
  voided
}

model Contract {
  id              String         @id @default(uuid()) @db.Uuid
  workspaceId     String         @db.Uuid
  customerId      String         @db.Uuid
  reference       String
  title           String
  status          ContractStatus @default(draft)
  proposalVersionId String?      @unique @db.Uuid // unique conversion key
  scopeSnapshot   String
  oneOffMinor     Int            @default(0)
  recurringMinor  Int            @default(0)
  currency        String         @default("GBP")
  signingMode     String         @default("manual_record") // manual_record | original_capture | external
  startDate       DateTime?      @db.Date
  endDate         DateTime?      @db.Date
  noticeDate      DateTime?      @db.Date
  completedAt     DateTime?
  completionRecordedBy String?
  completionEvidence   String?
  version         Int            @default(1)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  customer Customer @relation(fields: [customerId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  proposalVersion ProposalVersion? @relation(fields: [proposalVersionId], references: [id], onDelete: Restrict)
  project         Project?
  billingIntents  BillingIntent[]
  signingRequests SigningRequest[]
  documents       ContractDocument[]

  @@unique([workspaceId, reference])
  @@index([workspaceId, customerId])
  @@index([workspaceId, status])
}

// ───────── Delivery ─────────
enum ProjectStage {
  planned
  awaiting_assets
  design
  development
  qa
  client_review
  ready_to_launch
  launched
  completed
  held
  cancelled
}

model Project {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @db.Uuid
  customerId  String       @db.Uuid
  contractId  String?      @unique @db.Uuid // one project per contract
  reference   String
  name        String
  stage       ProjectStage @default(planned)
  awaitingContract Boolean @default(false)
  ownerId     String?      @db.Uuid
  dueDate     DateTime?    @db.Date
  scopeSnapshot String
  version     Int          @default(1)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  customer Customer @relation(fields: [customerId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  contract Contract? @relation(fields: [contractId], references: [id], onDelete: Restrict)
  tasks    Task[]
  tickets  Ticket[]
  updates  ProjectUpdate[]
  assetRequests AssetRequest[]

  @@unique([workspaceId, reference])
  @@index([workspaceId, customerId])
  @@index([workspaceId, stage])
}

model Task {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  projectId   String?   @db.Uuid
  customerId  String?   @db.Uuid
  title       String
  assigneeId  String?   @db.Uuid
  dueDate     DateTime? @db.Date
  doneAt      DateTime?
  createdAt   DateTime  @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([workspaceId, assigneeId, doneAt])
}

model ProjectUpdate {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  projectId   String   @db.Uuid
  body        String
  clientVisible Boolean @default(false)
  authorId    String?  @db.Uuid
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
}

model AssetRequest {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  projectId   String    @db.Uuid
  label       String // e.g. Logo, Copy, Photos
  required    Boolean   @default(true)
  dueDate     DateTime? @db.Date
  receivedAt  DateTime?
  note        String?
  createdAt   DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([workspaceId, projectId])
}

// A billing intention is NOT an invoice. Stripe invoices come later.
model BillingIntent {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  customerId  String   @db.Uuid
  contractId  String   @db.Uuid
  kind        String // deposit | balance | recurring_setup | one_off
  amountMinor Int
  currency    String   @default("GBP")
  status      String   @default("pending") // pending | paid (one-off) | active | past_due | cancelled (monthly)
  description String?
  paidAt      DateTime?
  paidVia     String? // stripe | bank | other
  stripeSessionId      String?
  stripePaymentIntent  String?
  stripeSubscriptionId String?
  createdAt   DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)

  @@unique([contractId, kind])
  @@index([stripeSubscriptionId])
}

// ───────── Calendar & Notes ─────────
model CalendarEvent {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  organiserId String    @db.Uuid
  title       String
  type        String    @default("internal_meeting")
  startsAt    DateTime
  endsAt      DateTime
  allDay      Boolean   @default(false)
  startDate   DateTime? @db.Date
  endDateExclusive DateTime? @db.Date
  timezone    String    @default("Europe/London")
  location    String?
  description String?
  status      String    @default("scheduled") // scheduled | cancelled
  customerId  String?   @db.Uuid
  projectId   String?   @db.Uuid
  icsUid      String    @unique
  icsSequence Int       @default(0)
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  attendees EventAttendee[]

  @@index([workspaceId, startsAt])
}

model EventAttendee {
  id        String @id @default(uuid()) @db.Uuid
  eventId   String @db.Uuid
  staffId   String @db.Uuid

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, staffId])
}

model Note {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  title       String
  body        String    @default("")
  parentId    String?   @db.Uuid
  ownerId     String    @db.Uuid
  visibility  String    @default("team") // team | private
  customerId  String?   @db.Uuid
  projectId   String?   @db.Uuid
  eventId     String?   @db.Uuid
  pinned      Boolean   @default(false)
  version     Int       @default(1)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  revisions NoteRevision[]
  comments  NoteComment[]

  @@index([workspaceId, archivedAt])
}

model NoteRevision {
  id       String   @id @default(uuid()) @db.Uuid
  noteId   String   @db.Uuid
  version  Int
  title    String
  body     String
  actorId  String   @db.Uuid
  createdAt DateTime @default(now())

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([noteId, version])
}

// ───────── System ─────────
model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  actorId     String? // user id; kept after user removal
  actorLabel  String?
  action      String
  targetType  String
  targetId    String
  customerId  String?  @db.Uuid
  visibility  String   @default("internal")
  detail      Json?
  createdAt   DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([workspaceId, customerId, createdAt])
}

model Outbox {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  topic       String
  dedupeKey   String
  payload     Json
  status      String    @default("pending") // pending | done | failed
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@unique([workspaceId, dedupeKey])
  @@index([status, createdAt])
}

model SequenceCounter {
  workspaceId String @db.Uuid
  name        String
  value       Int    @default(0)

  @@id([workspaceId, name])
}

// ───────── Original single-signer capture ─────────
// Electronic acceptance/signature capture. NOT a certificate/PAdES signature and not identity verification:
// the signer is whoever controlled the emailed link.
model SigningRequest {
  id            String    @id @default(uuid()) @db.Uuid
  workspaceId   String    @db.Uuid
  contractId    String    @db.Uuid
  signerName    String
  signerEmail   String
  status        String    @default("pending") // pending | signed | declined | voided | expired
  contentText   String // exact text shown to the signer (frozen at send time)
  contentSha256 String
  expiresAt     DateTime
  sentById      String?   @db.Uuid
  declineReason String?
  termsVersionId String?  @db.Uuid
  createdAt     DateTime  @default(now())

  contract  Contract         @relation(fields: [contractId], references: [id], onDelete: Restrict)
  signature SignatureRecord?

  @@index([workspaceId, contractId])
}

model SignatureRecord {
  id               String   @id @default(uuid()) @db.Uuid
  workspaceId      String   @db.Uuid
  signingRequestId String   @unique @db.Uuid
  signerName       String
  method           String // typed | drawn
  signatureImage   Bytes?
  consentText      String
  consentVersion   String
  ipAddress        String?
  userAgent        String?
  signedAt         DateTime @default(now())
  evidence         Json
  evidenceSha256   String

  request SigningRequest @relation(fields: [signingRequestId], references: [id], onDelete: Restrict)
}

model ContractDocument {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  contractId  String   @db.Uuid
  kind        String // final_pdf
  bytes       Bytes
  sha256      String
  createdAt   DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)

  @@unique([contractId, kind])
}

// Our standard Terms & Conditions. Published versions are immutable; changes create a new version.
model TermsVersion {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  kind        String    @default("terms") // terms | privacy | cookies | website_terms | dpa | change_request
  number      Int
  title       String    @default("Terms and Conditions")
  body        String // same simple markup as agreements: "## Heading" sections and "1.1 clause" lines
  status      String    @default("draft") // draft | published | retired
  publishedAt DateTime?
  publishedBy String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, kind, number])
  @@index([workspaceId, kind, status])
}

/// Shared team password vault. The secret is AES-256-GCM encrypted by the app before it is stored; never plain text.
model VaultEntry {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  title       String
  category    String   @default("general")
  username    String?
  url         String?
  notes       String?
  secret      String // "v1:<iv>:<tag>:<ciphertext>" (base64)
  createdBy   String
  updatedBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([workspaceId, title])
}

/// A comment on a Team Board post.
model NoteComment {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  noteId      String   @db.Uuid
  authorId    String   @db.Uuid // StaffMembership
  body        String
  createdAt   DateTime @default(now())

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId, createdAt])
}

/// A support ticket (an issue, a request or a question) from a person at a customer.
model Ticket {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  customerId  String    @db.Uuid
  contactId   String?   @db.Uuid
  projectId   String?   @db.Uuid
  reference   String
  kind        String    @default("issue") // issue | request | question
  title       String
  body        String
  status      String    @default("open") // open | in_progress | waiting_customer | resolved | closed
  priority    String    @default("normal") // low | normal | high | urgent
  source      String    @default("staff") // portal | staff
  assigneeId  String?   @db.Uuid // StaffMembership
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  customer Customer        @relation(fields: [customerId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  contact  Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  project  Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  comments TicketComment[]

  @@unique([workspaceId, reference])
  @@index([workspaceId, status])
  @@index([workspaceId, customerId])
}

model TicketComment {
  id            String   @id @default(uuid()) @db.Uuid
  workspaceId   String   @db.Uuid
  ticketId      String   @db.Uuid
  authorKind    String // staff | client
  authorName    String
  authorStaffId String?  @db.Uuid
  authorUserId  String?
  body          String
  internal      Boolean  @default(false) // internal notes are never shown to the customer
  createdAt     DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@index([ticketId, createdAt])
}

/// A file (screenshot, PDF) on a ticket. Stored in the database; `internal` files are never shown to the customer.
model Attachment {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String   @db.Uuid
  customerId   String   @db.Uuid
  ticketId     String   @db.Uuid
  commentId    String?  @db.Uuid // null = attached to the ticket's first message
  filename     String
  contentType  String
  sizeBytes    Int
  bytes        Bytes
  internal     Boolean  @default(false)
  uploadedBy   String // staff | client
  uploadedName String
  createdAt    DateTime @default(now())

  comment TicketComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

/// A care plan the team sells (for example Standard £29, E-commerce £39). Edited in Business settings.
model ServicePlan {
  id                String   @id @default(uuid()) @db.Uuid
  workspaceId       String   @db.Uuid
  key               String // standard | ecommerce | a slug
  name              String
  kind              String   @default("custom") // standard | ecommerce | custom
  monthlyMinor      Int      @default(0)
  revisionsPerMonth Int      @default(3)
  backupFrequency   String?
  backupRetention   String?
  summary           String?
  active            Boolean  @default(true)
  position          Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, key])
}

/// A client asks for a new person to get portal access. The team checks who they are, then approves or declines.
model AccessRequest {
  id               String    @id @default(uuid()) @db.Uuid
  workspaceId      String    @db.Uuid
  customerId       String    @db.Uuid
  requestedByUserId String
  requestedByName  String
  requestedByEmail String
  name             String
  email            String
  phone            String?
  position         String?
  role             String // admin | member | viewer
  billing          Boolean   @default(false)
  reason           String?
  status           String    @default("pending") // pending | approved | declined
  decidedByName    String?
  decidedAt        DateTime?
  declineReason    String?
  createdAt        DateTime  @default(now())

  @@index([workspaceId, status])
  @@index([customerId, status])
}
