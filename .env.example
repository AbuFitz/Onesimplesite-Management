# Copy to .env. Placeholders only; never commit real values.
# Runtime (least-privilege role, see docs/db/roles.sql)
DATABASE_URL=postgresql://oss_app:CHANGE_ME@localhost:5432/oss_manage
# Migrations (owner role, used only by `prisma migrate`)
MIGRATE_DATABASE_URL=postgresql://oss_migrate:CHANGE_ME@localhost:5432/oss_manage

# Origins (canonical links are built from these, never from request Host)
MANAGE_ORIGIN=http://manage.localhost:3000
PORTAL_ORIGIN=http://portal.localhost:3000
APP_ENV=development

# Auth (Better Auth). Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_32_BYTES_MINIMUM

# Email: leave RESEND_API_KEY empty to use the local mail sink (writes to .mail-sink/)
RESEND_API_KEY=
MAIL_ALLOWLIST=

# Not connected yet (adapters report "unconnected"): STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, S3_*

# Where internal copies (signed contracts etc.) are sent
INTERNAL_NOTICE_TO=hello@onesimplesite.co.uk
TRUST_PROXY=
